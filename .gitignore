# --- Node / TypeScript ---
node_modules/
dist/
*.tsbuildinfo

# --- Hardhat / contracts build output ---
packages/contracts/artifacts/
packages/contracts/cache/
packages/contracts/typechain-types/
packages/contracts/fhevmTemp/

# --- Rust ---
node/target/
# `shroud-core` is its own workspace (a path dependency, not a member), so `cargo test`
# there writes its own target directory next to the crate.
node/crates/shroud-core/target/

# --- SDK build output ---
packages/sdk/dist/

# --- Env / secrets ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# --- Logs / temp ---
*.log
npm-debug.log*

# --- Scratch / tool-cache dirs ---
# A PyManager cache directory left by tooling on the author's machine: nothing in the repo
# references it (no workflow, no README instruction), so it is local state, not source.
Python/

# --- ShardStore (DA) ---
# Content-addressed objects are hex-named files with no extension. Anything that lands next to
# server.mjs is shard data from a misconfigured DATA_DIR, not source, and committing it would put
# encrypted payloads in git history where they cannot be revoked.
infra/shardstore/0x*
infra/shardstore-data/

# --- Devnet generated output ---
# Written by `npm run deploy:devnet` inside the devnet container (bind-mounted to the host).
# Contract addresses for a throwaway chain: committing them would pin every checkout to one
# machine's deployment.
infra/devnet/addresses.json
infra/devnet/addresses.env

# --- Shroud ops bot -------------------------------------------------------
# The bot's token and the operator's Telegram id are secrets; never commit them.
bot/.env
bot/node_modules/
bot/state/
