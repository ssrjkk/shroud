{
    "name":  "@shroud/contracts",
    "version":  "0.1.0",
    "private":  true,
    "description":  "Shroud fhEVM contracts: FHE training orchestrator, escrow, streaming payouts, threshold decryption gate",
    "license":  "MIT",
    "scripts":  {
                    "build":  "hardhat compile",
                    "test":  "hardhat test && hardhat test test-vectors/vectors.spec.ts",
                    "typecheck":  "tsc --noEmit",
                    "clean":  "hardhat clean",
                    "deploy:devnet":  "hardhat run scripts/deploy.ts --network localhost",
                    "devnet:e2e":  "hardhat run scripts/devnet-e2e-check.ts --network localhost"
                },
    "dependencies":  {
                         "@fhevm/hardhat-plugin":  "0.13.0-1",
                         "@fhevm/solidity":  "^0.13.4",
                         "@openzeppelin/contracts":  "^5.0.2",
                         "encrypted-types":  "^0.0.4"
                     },
    "devDependencies":  {
                            "@nomicfoundation/hardhat-chai-matchers":  "^2.0.8",
                            "@nomicfoundation/hardhat-ethers":  "^4.2.1",
                            "@nomicfoundation/hardhat-network-helpers":  "^1.0.12",
                            "@typechain/ethers-v6":  "^0.5.1",
                            "@typechain/hardhat":  "^9.1.0",
                            "@types/chai":  "^4.3.20",
                            "@types/mocha":  "^10.0.9",
                            "@types/node":  "^22.9.0",
                            "chai":  "^4.5.0",
                            "ethers":  "^6.16.0",
                            "hardhat":  "^2.22.17",
                            "ts-node":  "^10.9.2",
                            "typechain":  "^8.3.2",
                            "typescript":  "^5.6.3"
                        },
    "engines": {
                           "node":  ">=22",
                           "npm":  ">=10"
                       },
    "overrides": {
                           "cookie":  "0.7.0",
                           "tmp":  "0.2.7",
                           "undici":  "6.28.1",
                           "diff":  "8.0.3",
                           "serialize-javascript":  "7.0.5",
                           "uuid":  "11.1.1",
                           "adm-zip":  "0.6.1",
                           "@fastify/busboy":  "3.2.2"
                       }
}
