{
  "name": "@shroud/sdk",
  "version": "0.1.0",
  "description": "Client-side Shroud SDK: local FHE encryption, shard upload, task contribution, and EIP-712 payment binding.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./file-store": {
      "types": "./dist/file-store.d.ts",
      "import": "./dist/file-store.js"
    },
    "./relayer": {
      "types": "./dist/relayer-encryptor.d.ts",
      "import": "./dist/relayer-encryptor.js"
    }
  },
  "files": ["dist", "src"],
  "engines": {
    "node": ">=18",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "export-abi": "node scripts/export-abi.cjs",
    "test": "npm run build && node --test --experimental-strip-types test/smoke.test.ts",
    "devnet:sdk": "node scripts/devnet-check.mjs"
  },
  "dependencies": {
    "@zama-fhe/relayer-sdk": "^0.4.5",
    "ethers": "^6.13.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.6.5"
  }
}
