# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. Never commit the filled-in file.
#
#   cp .env.example .env
#
# `.env` is git-ignored. If you do not have a token yet, talk to @BotFather and
# create one; it is the only genuinely secret value here.
# ---------------------------------------------------------------------------

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# --- Access control ---------------------------------------------------------
# REQUIRED, and deliberately so. The bot reports task budgets, operator
# addresses and dispute activity; without this gate, anyone who learns the bot
# username can read them and, with the token, post as it.
#
# Comma-separated Telegram numeric user or chat IDs. To find yours: message the
# bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates and read
# "message"."from"."id".
#
# Leave empty -> the bot refuses to start, rather than running wide open.
TELEGRAM_ALLOWED_IDS=

# Owner of the /admin panel (read-only deployment diagnostics: redacted RPC,
# chain head, contract wiring, send-queue health, watcher counts). Defaults to
# 397602448 (the deployer); set it explicitly when someone else operates the
# bot. Non-owners get a one-line refusal and cost the deployment zero RPC.
# TELEGRAM_OWNER_ID=397602448

# --- Chain ------------------------------------------------------------------
# Must match the chain the contracts are actually deployed on.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Per-request RPC deadline in ms. A dead node must fail reads fast instead of
# hanging every poll loop forever. Minimum 1000.
# RPC_TIMEOUT_MS=15000

# Contract addresses. Any zero value makes the matching command reply with a
# clear "not configured" instead of pretending the pool is empty.
CIPHER_TASK_ADDRESS=0x0000000000000000000000000000000000000000
PAYMENT_VAULT_ADDRESS=0x0000000000000000000000000000000000000000
NETWORK_PARAMS_ADDRESS=0x0000000000000000000000000000000000000000
# ProofVerifier (the timelocked rotation wrapper, not the STARK backend it
# points at). Devnet points the verifier slot at a mock, so this stays zero
# there; a production deployment sets it to the ProofVerifier address.
VERIFIER_ADDRESS=0x0000000000000000000000000000000000000000

# --- Alerting ---------------------------------------------------------------
# How often to scan for new logs, in seconds. Polling, not websockets: the
# devnet RPC is a single local process and a websocket subscription to a chain
# that restarts loses its replay buffer.
POLL_INTERVAL_SECONDS=15

# Blocks to look back on (re)start, so a restart does not silently skip events.
CATCHUP_BLOCKS=2000

# Set to 1 to get an alert when any node commits a trace digest that disagrees
# with the current winner. This is the single most useful signal in the system.
ALERT_COMMIT_MISMATCH=1

# Set to 1 to get an alert on every dispute and every dispute rejection.
ALERT_DISPUTES=1

# Set to 1 to get an alert when a NetworkParams key rotation is queued,
# approved, cancelled or lands. This one is worth having on: it is how a key
# swap would first become visible.
ALERT_KEY_ROTATION=1

# Set to 1 to get an alert when a treasury rotation is proposed, executed or
# cancelled. Same window logic as the key rotation: the proposal is the only
# moment anyone can still say no.
ALERT_TREASURY=1

# Set to 1 to get an alert when a ProofVerifier rotation is proposed, executed
# or cancelled. The verifier gates every payout, so a swap here is as
# sensitive as a key swap. Needs VERIFIER_ADDRESS above; unset means silence
# (devnet points the slot at a mock, so it stays unset there).
ALERT_VERIFIER_ROTATION=1

# --- Presentation -----------------------------------------------------------
# 1 for HTML formatting, 0 for plain text. HTML is nicer for status tables.
HTML_MODE=1

LOG_LEVEL=info

# --- Anti-abuse (per-chat throttling, flood detection, tarpit/shadowban) ----
# Квоты считаются в единицах RPC-нагрузки за окно: /pool стоит 15, /task 5,
# /status 4, остальное (включая кнопки) 1. Превышение → 429-подобный ответ с Retry-After и
# ростом скоринга; серия → tarpit (MEDIUM), затем shadowban — правдоподобный
# ответ без единого RPC (HIGH). Значения ниже — дефолты, можно не задавать.
# ABUSE_CHAT_BUDGET=60
# ABUSE_CHAT_WINDOW_MS=60000
# ABUSE_RISK_MEDIUM=20
# ABUSE_RISK_HIGH=60
# ABUSE_TARPIT_MIN_MS=1000
# ABUSE_TARPIT_MAX_MS=3000
# ABUSE_HANDLER_TIMEOUT_MS=20000
# ABUSE_MAX_TEXT_LEN=1024
# ABUSE_MAX_ARGS=8
# ABUSE_FLOOD_K=5
